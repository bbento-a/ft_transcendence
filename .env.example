# ============================================================
#  NON-SECRET configuration only.
#
#  Every credential (database password, JWT signing key, OAuth
#  client ids and secrets) lives in secrets/*.txt and is mounted
#  into the containers as a Docker secret.
#
#  `make setup` creates this file and the secrets/ files for you.
# ============================================================

# Database role and name. Not credentials — they are worthless without the
# password (which IS a secret, in secrets/postgres_password.txt), and the db
# service publishes no port and sits on an internal-only network.
#
# Changing these AFTER the first `make up` has no effect: Postgres only reads
# them while initialising an empty data directory. Run `make fclean` first.
POSTGRES_USER=transcendence
POSTGRES_DB=transcendence

# OAuth redirect URLs. Not secret — they end up in the browser's address
# bar — but they must match EXACTLY what you registered with the provider.
#   Google -> https://console.cloud.google.com
#   42     -> https://profile.intra.42.fr/oauth/applications
#
# The 42 key is FT_* here because a shell variable name cannot start with a
# digit; docker-compose.yml maps it to 42_CALLBACK_URL for the backend.
GOOGLE_CALLBACK_URL=https://localhost:2222/api/auth/google/redir
FT_CALLBACK_URL=https://localhost:2222/api/auth/42/redir
