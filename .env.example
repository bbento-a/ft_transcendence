# ==========================================================
#  Non-secret configuration.
#
#  Every value in here is safe to read: names, hostnames and
#  public identifiers. Real credentials do NOT live in this
#  file — they are Docker secrets under secrets/.
#  See secrets/README.md.
#
#  `make setup` copies this file to .env (gitignored).
# ==========================================================

POSTGRES_USER=transcendence
POSTGRES_DB=transcendence

# OAuth — Google. Register an app at https://console.cloud.google.com
# The callback URL must match exactly what you register.
# The client SECRET goes in secrets/google_client_secret.txt
GOOGLE_CLIENT_ID=<google client id>
GOOGLE_CALLBACK_URL=https://localhost:2222/api/auth/google/redir

# OAuth — 42. Register an app at https://profile.intra.42.fr/oauth/applications
# (env keys use FT_ because shell var names cannot start with a digit; the
# backend reads them as 42_CLIENT_ID etc. via docker-compose mapping)
# The client SECRET goes in secrets/ft_client_secret.txt
FT_CLIENT_ID=<42 client id>
FT_CALLBACK_URL=https://localhost:2222/api/auth/42/redir
